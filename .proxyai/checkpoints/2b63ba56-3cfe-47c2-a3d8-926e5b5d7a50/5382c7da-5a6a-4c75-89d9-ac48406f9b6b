            "content": "1\tpackage io.lin.reader.ui.feature.reading\n2\t\n3\timport android.app.Application\n4\timport android.graphics.PointF\n5\timport android.net.Uri\n6\timport android.provider.OpenableColumns\n7\timport android.util.Log\n8\timport androidx.compose.runtime.mutableStateMapOf\n9\timport androidx.core.net.toUri\n10\timport androidx.lifecycle.AndroidViewModel\n11\timport androidx.lifecycle.viewModelScope\n12\timport com.artifex.mupdf.fitz.SeekableInputStream\n13\timport com.artifex.mupdf.viewer.ContentInputStream\n14\timport com.artifex.mupdf.viewer.OutlineActivity\n15\timport io.lin.reader.data.booksrepository.BooksRepository\n16\timport io.lin.reader.data.database.Bookmark\n17\timport io.lin.reader.data.database.PageSetting\n18\timport io.lin.reader.data.database.Series\n19\timport io.lin.reader.data.database.Volume\n20\timport io.lin.reader.data.preferences.ReaderPreferences\n21\timport io.lin.reader.data.preferences.ReaderPreferencesForTest\n22\timport io.lin.reader.data.preferences.ReaderPreferencesInterface\n23\timport io.lin.reader.data.preferences.ReflowPreferences\n24\timport io.lin.reader.data.preferences.ReflowPreferencesInterface\n25\timport io.lin.reader.data.preferences.ReflowPreferencesForTest\n26\timport io.lin.reader.data.preferences.UserPreferencesRepository\n27\timport io.lin.reader.data.preferences.VolumeSortMethod\n28\timport io.lin.reader.ui.feature.reading.feature.MuPDFSearch\n29\timport kotlinx.coroutines.Dispatchers\n30\timport kotlinx.coroutines.Job\n31\timport kotlinx.coroutines.currentCoroutineContext\n32\timport kotlinx.coroutines.delay\n33\timport kotlinx.coroutines.flow.MutableStateFlow\n34\timport kotlinx.coroutines.flow.StateFlow\n35\timport kotlinx.coroutines.flow.asStateFlow\n36\timport kotlinx.coroutines.flow.collectLatest\n37\timport kotlinx.coroutines.flow.update\n38\timport kotlinx.coroutines.isActive\n39\timport kotlinx.coroutines.launch\n40\timport kotlinx.coroutines.sync.Mutex\n41\timport kotlinx.coroutines.sync.withLock\n42\timport kotlinx.coroutines.withContext\n43\timport kotlin.time.Duration.Companion.minutes\n44\t\n45\tdata class DocumentSearchUiState(\n46\t    val currentSearchQuery: String = \"\",\n47\t    val isSearching: Boolean = false,\n48\t    val searchProgress: Float = 0f,\n49\t)\n50\t\n51\tdata class ReadingUiState(\n52\t    val error: String? = null,\n53\t    val currentPage: Int = 0,\n54\t    val volume: Volume? = null,\n55\t    val series: Series? = null,\n56\t    val volumeList: List<Volume> = emptyList(),\n57\t    val isEdgeVolume: Pair<Boolean, Boolean> = false to false,\n58\t    val bookmarkList: List<Bookmark> = emptyList(),\n59\t    val outlineList: List<OutlineActivity.Item> = emptyList(),\n60\t    val pageSettings: Map<Int, PageSetting> = emptyMap(),\n61\t    val searchUiState: DocumentSearchUiState = DocumentSearchUiState(),\n62\t    val highlightLinks: Boolean = false,\n63\t)\n64\t\n65\tprivate const val APP = \"MuPDF\"\n66\t\n67\tinterface ReadingScreenViewmodelInterface {\n68\t    val uiState: StateFlow<ReadingUiState>\n69\t    val mCore: StateFlow<MuPDFCoreExtended?>\n70\t    val muPDFSearch: StateFlow<MuPDFSearch?>\n71\t    val mPageSizes: Map<Int, PointF>\n72\t    val readerPreferences: ReaderPreferencesInterface\n73\t    val reflowPreferences: ReflowPreferencesInterface\n74\t\n75\t    suspend fun loadVolume(bookId: Long, jumpToPage: Int? = null, lastVolumeId: Long? = null)\n76\t    fun clearResource()\n77\t    fun loadPageSize(pageIndex: Int)\n78\t    fun performLayout(width: Float, height: Float)\n79\t    fun goToPage(pageIndex: Int)\n80\t    fun toggleHighlightLinks()\n81\t    fun rotateCurrentPage(pageIndex: Int)\n82\t    fun switchVolume(targetVolumeId: Long)\n83\t    fun switchVolume(direction: Int)\n84\t    fun updateSearchQuery(query: String)\n85\t    suspend fun executeStepSearch(direction: Int, currentPageIndex: Int): Boolean\n86\t    suspend fun executeFullSearch(): Boolean\n87\t    fun clearSearch()\n88\t    fun toggleFavouriteState()\n89\t    fun isPageBookmarked(currentPage: Int, bookmarkList: List<Bookmark>): Boolean\n90\t    fun generateAutoBookmarkLabel(): String\n91\t    fun addBookmark(label: String, pageNumber: Int)\n92\t    fun deleteBookmark(pageNumber: Int)\n93\t}\n94\t\n95\tclass ReadingScreenViewModel(\n96\t    application: Application,\n97\t    userPreferencesRepository: UserPreferencesRepository,\n98\t    private val booksRepository: BooksRepository\n99\t) : AndroidViewModel(application), ReadingScreenViewmodelInterface {\n100\t    override val readerPreferences =\n101\t        ReaderPreferences(userPreferencesRepository, viewModelScope)\n102\t    override val reflowPreferences =\n103\t        ReflowPreferences(userPreferencesRepository, viewModelScope)\n104\t\n105\t    private val _uiState = MutableStateFlow(ReadingUiState())\n106\t    override val uiState: StateFlow<ReadingUiState> = _uiState.asStateFlow()\n107\t\n108\t    private val _mCore = MutableStateFlow<MuPDFCoreExtended?>(null)\n109\t    override val mCore: StateFlow<MuPDFCoreExtended?> = _mCore.asStateFlow()\n110\t\n111\t    private val _muPDFSearch = MutableStateFlow<MuPDFSearch?>(null)\n112\t    override val muPDFSearch: StateFlow<MuPDFSearch?> = _muPDFSearch.asStateFlow()\n113\t\n114\t    override val mPageSizes = mutableStateMapOf<Int, PointF>()\n115\t\n116\t    private var searchJob: Job? = null\n117\t    private var bookmarksJob: Job? = null\n118\t    private var pageSettingsJob: Job? = null\n119\t    private var historySyncJob: Job? = null\n120\t    private val rendererMutex = Mutex()\n121\t\n122\t    /**\n123\t     * 将上面的成员变量清理成默认状态\n124\t     */\n125\t    override fun clearResource() {\n126\t        _mCore.value?.onDestroy()\n127\t        _mCore.value = null\n128\t        clearSearch()\n129\t        bookmarksJob?.cancel()\n130\t        pageSettingsJob?.cancel()\n131\t        historySyncJob?.cancel()\n132\t        mPageSizes.clear()\n133\t    }\n134\t\n135\t    /**\n136\t     * 防止 MuPDFCore 造成内存泄漏以及搜素未结束造成的性能浪费\n137\t     */\n138\t    override fun onCleared() {\n139\t        syncHistory()\n140\t        clearResource()\n141\t    }\n142\t\n143\t    private fun openBuffer(buffer: ByteArray, magic: String): MuPDFCoreExtended? {\n144\t        return try {\n145\t            MuPDFCoreExtended(buffer, magic)\n146\t        } catch (e: Exception) {\n147\t            Log.e(APP, \"Error opening document buffer: $e\")\n148\t            null\n149\t        }\n150\t    }\n151\t\n152\t    private fun openStream(stm: SeekableInputStream, magic: String): MuPDFCoreExtended? {\n153\t        return try {\n154\t            val core = MuPDFCoreExtended(stm, magic)\n155\t            core\n156\t        } catch (e: Exception) {\n157\t            Log.e(APP, \"Error opening document stream: $e\")\n158\t            null\n159\t        }\n160\t    }\n161\t\n162\t    private suspend fun openCore(uri: Uri, size: Long, mimetype: String): MuPDFCoreExtended? =\n163\t        withContext(Dispatchers.IO) {\n164\t            val cr = getApplication<Application>().contentResolver\n165\t            var buf: ByteArray? = null\n166\t\n167\t            try {\n168\t                val limit = 8 * 1024 * 1024\n169\t                if (size < 0) { // size is unknown\n170\t                    cr.openInputStream(uri)?.use { isStream ->\n171\t                        val tempBuf = ByteArray(limit)\n172\t                        val used = isStream.read(tempBuf)\n173\t                        val atEOF = isStream.read() == -1\n174\t                        if (used >= 0 && (used < limit || atEOF)) {\n175\t                            buf = if (tempBuf.size == used) tempBuf else tempBuf.copyOf(used)\n176\t                        }\n177\t                    }\n178\t                } else if (size <= limit) { // size is known and below limit\n179\t                    cr.openInputStream(uri)?.use { isStream ->\n180\t                        val tempBuf = ByteArray(size.toInt())\n181\t                        val used = isStream.read(tempBuf)\n182\t                        if (used >= 0 && used == size.toInt()) {\n183\t                            buf = tempBuf\n184\t                        }\n185\t                    }\n186\t                }\n187\t            } catch (_: OutOfMemoryError) {\n188\t                buf = null\n189\t            } catch (e: Exception) {\n190\t                Log.e(APP, \"Error reading core: $e\")\n191\t                buf = null\n192\t            }\n193\t\n194\t            val buffer = buf\n195\t            if (buffer != null) {\n196\t                Log.i(APP, \"  Opening document from memory buffer of size \" + buffer.size)\n197\t                openBuffer(buffer, mimetype)\n198\t            } else {\n199\t                Log.i(APP, \"  Opening document from stream\")\n200\t                openStream(ContentInputStream(cr, uri, size), mimetype)\n201\t            }\n202\t        }\n203\t\n204\t    /**\n205\t     * 搬运 DocumentActivity.java 的 onCreate() 方法中的部分逻辑。\n206\t     * 实现解析 URI 、解析文件大小和类型，并将结果传递给 openCore() 以初始化 MuPDFCore 。\n207\t     */\n208\t    private suspend fun createMuPDFDocumentActivity(volume: Volume) {\n209\t        val uri = volume.bookFileUri.toUri()\n210\t        val cr = getApplication<Application>().contentResolver\n211\t\n212\t        var fileSize: Long = -1\n213\t\n214\t        // Query metadata\n215\t        try {\n216\t            cr.query(\n217\t                uri,\n218\t                arrayOf(OpenableColumns.SIZE),\n219\t                null,\n220\t                null,\n221\t                null\n222\t            )?.use { cursor ->\n223\t                if (cursor.moveToFirst()) {\n224\t                    val sizeIndex = cursor.getColumnIndex(OpenableColumns.SIZE)\n225\t                    if (sizeIndex >= 0 && !cursor.isNull(sizeIndex)) {\n226\t                        fileSize = cursor.getLong(sizeIndex)\n227\t                    }\n228\t                }\n229\t            }\n230\t        } catch (e: Exception) {\n231\t            Log.e(APP, \"Error querying URI metadata: $e\")\n232\t        }\n233\t\n234\t        if (fileSize == 0L) fileSize = -1\n235\t\n236\t        val core = openCore(uri, fileSize, volume.mimeType)\n237\t        if (core != null) {\n238\t            _mCore.value = core\n239\t            _muPDFSearch.value = MuPDFSearch()\n240\t        }\n241\t    }\n242\t\n243\t    /**\n244\t     * 加载单册：始终使用 Book ID 从数据库进行单册查询，确保数据时效性以及数据源唯一\n245\t     * @param bookId 目标单册\n246\t     * @param jumpToPage 是否顺便跳转至指定页，不传默认按历史记录\n247\t     * @param lastVolumeId 如果是在阅读器内执行单册切换，传递切换前的单册 ID\n248\t     */\n249\t    override suspend fun loadVolume(\n250\t        bookId: Long,\n251\t        jumpToPage: Int?,\n252\t        lastVolumeId: Long?\n253\t    ) {\n254\t        if (_mCore.value != null && bookId == lastVolumeId) return\n255\t\n256\t        // 清理旧资源\n257\t        clearResource()\n258\t\n259\t        // 获取新数据\n260\t        val volume = booksRepository.getVolumeById(bookId)\n261\t        val series = booksRepository.getSeriesById(volume.seriesId)\n262\t        val volumeList = booksRepository.getVolumesInSeries(\n263\t            seriesId = volume.seriesId,\n264\t            order = VolumeSortMethod.Name,\n265\t            isAscending = true\n266\t        )\n267\t        // 更新 UI\n268\t        _uiState.update {\n269\t            it.copy(\n270\t                volume = volume,\n271\t                series = series,\n272\t                volumeList = volumeList,\n273\t                currentPage = jumpToPage ?: volume.lastReadPage,\n274\t                isEdgeVolume = calculateEdgeVolume(volume, volumeList),\n275\t                error = null,\n276\t                highlightLinks = false,\n277\t            )\n278\t        }\n279\t\n280\t        // 加载 MuPDFCore\n281\t        createMuPDFDocumentActivity(volume)\n282\t\n283\t        // 获取目录\n284\t        val core = _mCore.value\n285\t        if (core != null && core.hasOutline()) {\n286\t            val outline = core.outline\n287\t            if (outline != null) {\n288\t                _uiState.update { it.copy(outlineList = outline, error = null) }\n289\t            }\n290\t        }\n291\t\n292\t        // 获取书签和页面设置\n293\t        observeBookmarks(bookId)\n294\t        observePageSettings(bookId)\n295\t\n296\t        // 页面跳转逻辑 (0-based)\n297\t        val startPage = jumpToPage ?: (if (volume.lastReadPage >= 0) volume.lastReadPage else 0)\n298\t        goToPage(startPage)\n299\t        updateLastRead(startPage)\n300\t\n301\t        // 启动定时历史记录同步\n302\t        startHistorySync()\n303\t    }\n304\t\n305\t    /**\n306\t     * 获取单页大小，结果会存进 mPageSizes\n307\t     */\n308\t    override fun loadPageSize(pageIndex: Int) {\n309\t        val core = _mCore.value ?: return\n310\t        if (mPageSizes.containsKey(pageIndex)) return\n311\t\n312\t        viewModelScope.launch(Dispatchers.IO) {\n313\t            rendererMutex.withLock {\n314\t                try {\n315\t                    val size = core.getPageSize(pageIndex)\n316\t                    withContext(Dispatchers.Main) {\n317\t                        mPageSizes[pageIndex] = size\n318\t                    }\n319\t                } catch (e: Exception) {\n320\t                    Log.e(\"ReadingScreenViewModel\", \"Error getting page size for $pageIndex\", e)\n321\t                }\n322\t            }\n323\t        }\n324\t    }\n325\t\n326\t    /**\n327\t     * 执行重排逻辑：\n328\t     *  1. 容器大小变化\n329\t     */\n330\t    override fun performLayout(width: Float, height: Float) {\n331\t        val core = _mCore.value ?: return\n332\t        if (!core.isReflowable) return\n333\t\n334\t        viewModelScope.launch(Dispatchers.IO) {\n335\t            rendererMutex.withLock {\n336\t                val currentP = _uiState.value.currentPage\n337\t\n338\t                // 注入自定义 CSS\n339\t                core.customReflowStyle(\n340\t                    publisherCss = false,\n341\t                    userCss = reflowPreferences.generateCss()\n342\t                )\n343\t\n344\t                // 执行排版: layout(int oldPage, int w, int h, int em)\n345\t                val newPage = core.layout(\n346\t                    currentP,\n347\t                    width.toInt(),\n348\t                    height.toInt(),\n349\t                    reflowPreferences.fontSize\n350\t                )\n351\t\n352\t                // 更新状态\n353\t                val newTotalPages = core.countPages()\n354\t                withContext(Dispatchers.Main) {\n355\t                    mPageSizes.clear()\n356\t                    _uiState.update { state ->\n357\t                        state.copy(\n358\t                            volume = state.volume?.copy(totalPages = newTotalPages),\n359\t                            currentPage = newPage\n360\t                        )\n361\t                    }\n362\t                }\n363\t            }\n364\t        }\n365\t    }\n366\t\n367\t    /**\n368\t     * 页面跳转\n369\t     */\n370\t    override fun goToPage(pageIndex: Int) {\n371\t        val totalCount = _uiState.value.volume?.totalPages ?: _mCore.value?.countPages() ?: 0\n372\t        if (totalCount <= 0) return\n373\t        // 增加边界检查：确保跳转页码在 0 到 (总页数-1)之间 (0-based)\n374\t        val safeIndex = pageIndex.coerceIn(0, totalCount - 1)\n375\t        _uiState.update { it.copy(currentPage = safeIndex) }\n376\t    }\n377\t\n378\t    /**\n379\t     * 是否显示链接高亮\n380\t     */\n381\t    override fun toggleHighlightLinks() {\n382\t        _uiState.update { it.copy(highlightLinks = !it.highlightLinks) }\n383\t    }\n384\t\n385\t    // 单页特殊设置\n386\t    private fun observePageSettings(bookId: Long) {\n387\t        pageSettingsJob?.cancel()\n388\t        pageSettingsJob = viewModelScope.launch {\n389\t            booksRepository.getPageSettingsByVolumeId(bookId).collectLatest { settings ->\n390\t                val settingsMap = settings.associateBy { it.pageIndex }\n391\t                _uiState.update { it.copy(pageSettings = settingsMap) }\n392\t            }\n393\t        }\n394\t    }\n395\t\n396\t    /**\n397\t     * 响应操作按钮旋转单页\n398\t     */\n399\t    override fun rotateCurrentPage(pageIndex: Int) {\n400\t        val volumeId = _uiState.value.volume?.id ?: return\n401\t        val currentSetting = _uiState.value.pageSettings[pageIndex]\n402\t        val currentRotation = currentSetting?.rotation ?: 0\n403\t        val newRotation = (currentRotation + 90) % 360\n404\t\n405\t        viewModelScope.launch {\n406\t            booksRepository.upsertPageSetting(\n407\t                PageSetting(\n408\t                    volumeId = volumeId,\n409\t                    pageIndex = pageIndex,\n410\t                    rotation = newRotation\n411\t                )\n412\t            )\n413\t        }\n414\t    }\n415\t\n416\t    // 单册切换\n417\t    /**\n418\t     * 切换单册：接受 Volume Id ，直接跳转\n419\t     */\n420\t    override fun switchVolume(targetVolumeId: Long) {\n421\t        val lastVolumeId = _uiState.value.volume?.id\n422\t        if (lastVolumeId == targetVolumeId) return\n423\t        viewModelScope.launch {\n424\t            this@ReadingScreenViewModel.loadVolume(targetVolumeId)\n425\t        }\n426\t    }\n427\t\n428\t    /**\n429\t     * 切换单册：接受一个方向偏移量。\n430\t     */\n431\t    override fun switchVolume(direction: Int) {\n432\t        val list = _uiState.value.volumeList\n433\t        val currentVolumeId = _uiState.value.volume?.id ?: return\n434\t\n435\t        val currentIndex = list.indexOfFirst { it.id == currentVolumeId }\n436\t\n437\t        if (currentIndex != -1) {\n438\t            val targetIndex = currentIndex + direction\n439\t\n440\t            // 边界检查\n441\t            if (targetIndex in list.indices) {\n442\t                viewModelScope.launch {\n443\t                    this@ReadingScreenViewModel.loadVolume(list[targetIndex].id)\n444\t                }\n445\t            } else {\n446\t                Log.w(\"ReadingViewModel\", \"Target volume index $targetIndex is out of bounds.\")\n447\t            }\n448\t        }\n449\t    }\n450\t\n451\t    /**\n452\t     * 计算当前阅读的单册是否是系列的首尾册\n453\t     */\n454\t    private fun calculateEdgeVolume(v: Volume?, list: List<Volume>): Pair<Boolean, Boolean> {\n455\t        if (v == null || list.isEmpty()) return false to false\n456\t        return (list.first().id == v.id) to (list.last().id == v.id)\n457\t    }\n458\t\n459\t    // 搜索\n460\t    /**\n461\t     * 更新搜索文本\n462\t     */\n463\t    override fun updateSearchQuery(query: String) {\n464\t        _uiState.update {\n465\t            it.copy(\n466\t                searchUiState = DocumentSearchUiState(query)\n467\t            )\n468\t        }\n469\t    }\n470\t\n471\t    /**\n472\t     * 单步搜索\n473\t     */\n474\t    override suspend fun executeStepSearch(direction: Int, currentPageIndex: Int): Boolean {\n475\t        val searcher = _muPDFSearch.value ?: return false\n476\t        val core = _mCore.value ?: return false\n477\t        val query = _uiState.value.searchUiState.currentSearchQuery\n478\t        if (query.isBlank()) return false\n479\t\n480\t        searchJob?.cancel() // 停止之前的搜索\n481\t        searchJob = currentCoroutineContext()[Job] // 捕获当前任务引用，以便手动停止\n482\t\n483\t        // Loading\n484\t        _uiState.update { it.copy(searchUiState = it.searchUiState.copy(isSearching = true)) }\n485\t\n486\t        return try {\n487\t            // IO 线程执行并等待结果\n488\t            val result = withContext(Dispatchers.IO) {\n489\t                searcher.findNextHit(\n490\t                    core = core,\n491\t                    text = query,\n492\t                    direction = direction,\n493\t                    displayPage = currentPageIndex,\n494\t                    onProgress = { p: Int ->\n495\t                        val totalPage = _uiState.value.volume?.totalPages ?: core.countPages()\n496\t                        val progress =\n497\t                            if (direction > 0) (p - currentPageIndex).toFloat() / (totalPage - currentPageIndex - 1)\n498\t                            else (currentPageIndex - p).toFloat() / (currentPageIndex + 1)\n499\t                        _uiState.update {\n500\t                            it.copy(\n501\t                                searchUiState = it.searchUiState.copy(\n502\t                                    searchProgress = progress\n503\t                                )\n504\t                            )\n505\t                        }\n506\t                    }\n507\t                )\n508\t            }\n509\t\n510\t            // 搜到了就跳转翻页\n511\t            if (result != null) {\n512\t                goToPage(result.pageIndex)\n513\t                true\n514\t            } else {\n515\t                false\n516\t            }\n517\t        } finally {\n518\t            _uiState.update { it.copy(searchUiState = it.searchUiState.copy(isSearching = false)) }\n519\t            searchJob = null\n520\t        }\n521\t    }\n522\t\n523\t    /**\n524\t     * 全文档搜索\n525\t     */\n526\t    override suspend fun executeFullSearch(): Boolean {\n527\t        val searcher = _muPDFSearch.value ?: return false\n528\t        val core = _mCore.value ?: return false\n529\t        val query = _uiState.value.searchUiState.currentSearchQuery\n530\t        if (query.isBlank()) return false\n531\t\n532\t        searchJob?.cancel()\n533\t        searchJob = currentCoroutineContext()[Job] // 捕获当前任务引用\n534\t\n535\t        _uiState.update { it.copy(searchUiState = it.searchUiState.copy(isSearching = true)) }\n536\t\n537\t        return try {\n538\t            // IO 线程执行并等待结果\n539\t            val results = withContext(Dispatchers.IO) {\n540\t                searcher.searchDocument(\n541\t                    core = core,\n542\t                    text = query,\n543\t                    onProgress = { p ->\n544\t                        val totalPage = _uiState.value.volume?.totalPages ?: core.countPages()\n545\t                        val progress = if (totalPage > 0) (p + 1).toFloat() / totalPage else 0f\n546\t     
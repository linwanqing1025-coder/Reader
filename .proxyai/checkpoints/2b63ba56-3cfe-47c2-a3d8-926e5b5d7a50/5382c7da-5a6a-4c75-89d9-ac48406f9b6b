\n92\t    val mSelectedArea: SelectionArea? = null,\n93\t)\n94\t\n95\tdata class PatchState(\n96\t    // mPatchBm\n97\t    val mPatchBm: Bitmap? = null,\n98\t    // patchViewSize: 缩放后整页的大小（单位为屏幕像素值）\n99\t    val patchViewSize: IntSize = IntSize.Zero,\n100\t    // patchArea: 缩放后瓦片层的位置（相对于整页，单位为屏幕像素值）\n101\t    val patchArea: Rect = Rect.Zero,\n102\t    val scale: Float = 1f\n103\t)\n104\t\n105\t// Color\n106\tprivate val HIGHLIGHT_COLOR = Color(0x80CC6600)\n107\tprivate val LINK_COLOR = Color(0x800066CC)\n108\tprivate val BACKGROUND_COLOR = Color.White\n109\t\n110\t/**\n111\t * 用 Kotlin 和 Compose 重写的 PageView.java\n112\t */\n113\t@OptIn(FlowPreview::class)\n114\t@Composable\n115\tfun MuPDFPage(\n116\t    modifier: Modifier,\n117\t    // mPageNumber, getPage()\n118\t    mPageNumber: Int,\n119\t    pdfSize: PointF,\n120\t    // mHighlightLinks, setLinkHighlighting()\n121\t    mHighlightLinks: Boolean = true,\n122\t) {\n123\t    // mContext\n124\t    val mContext = LocalContext.current\n125\t    val density = LocalDensity.current\n126\t    val scope = rememberCoroutineScope()\n127\t\n128\t    // Viewmodel\n129\t    val viewModel = LocalReadingViewModel.current!!\n130\t\n131\t    // mCore\n132\t    val mCore = viewModel.mCore.collectAsState().value!!\n133\t\n134\t    // SearchTask, SearchResult\n135\t    val searcher = viewModel.muPDFSearch.collectAsState().value!!\n136\t\n137\t    // mSearchBoxes\n138\t    val focusedHit = searcher.focusedItem\n139\t    val allHits = searcher.allItems\n140\t    val mSearchBoxes = if (focusedHit != null && focusedHit.pageIndex == mPageNumber) {\n141\t        // 先在单页结果中找\n142\t        focusedHit.searchBoxes\n143\t    } else allHits?.find { it.pageIndex == mPageNumber }?.searchBoxes\n144\t\n145\t    // mScale\n146\t    val transform = LocalReadingTransform.current\n147\t\n148\t    // 当前单页状态\n149\t    var pageState by remember { mutableStateOf(PageState()) }\n150\t    // 记录当前的单页与屏幕交集\n151\t    var patchAreaCache by remember { mutableStateOf(Rect.Zero) }\n152\t    // 请求渲染的瓦片状态\n153\t    var patchState by remember { mutableStateOf(PatchState()) }\n154\t\n155\t    // 更新文本选择\n156\t    val updateSelection: (Point?, Point?) -> Unit = { p1, p2 ->\n157\t        if (p1 != null && p2 != null) {\n158\t            scope.launch(Dispatchers.IO) {\n159\t                val sText = mCore.getStructuredText(mPageNumber)\n160\t                val quads = sText?.highlight(p1, p2)\n161\t                val text = sText?.copy(p1, p2)\n162\t                withContext(Dispatchers.Main) {\n163\t                    pageState = pageState.copy(\n164\t                        mSelectionQuads = quads,\n165\t                        mSelectedText = text,\n166\t                        mSelectedArea = SelectionArea(p1, p2)\n167\t                    )\n168\t                }\n169\t                sText?.destroy()\n170\t            }\n171\t        }\n172\t    }\n173\t\n174\t    BoxWithConstraints(\n175\t        modifier = modifier\n176\t            .aspectRatio(pdfSize.x / pdfSize.y)\n177\t            .background(BACKGROUND_COLOR)\n178\t            .onGloballyPositioned { coordinates -> // calculate patchArea\n179\t                // 源码：\n180\t                // Rect viewArea = new Rect(getLeft(),getTop(),getRight(),getBottom());\n181\t                // final Point patchViewSize = new Point(viewArea.width(), viewArea.height());\n182\t                // final Rect patchArea = new Rect(0, 0, mParentSize.x, mParentSize.y);\n183\t                // if (!patchArea.intersect(viewArea)) return;\n184\t                // 这里由于原文件的 View 的各边界值会相应缩放，而 BoxWithConstraints 的 constraints 不会随缩放变化，因此这里逻辑不同\n185\t\n186\t                // 获取屏幕窗口坐标系下的可见区域矩形\n187\t                val patchRectInWindow = coordinates.boundsInWindow(clipBounds = true)\n188\t\n189\t                if (!patchRectInWindow.isEmpty) {\n190\t                    // 将屏幕坐标系下矩形的 4 个顶点，通过矩阵逆变换映射回组件本地坐标系\n191\t                    val p1 = coordinates.windowToLocal(patchRectInWindow.topLeft)\n192\t                    val p2 = coordinates.windowToLocal(patchRectInWindow.topRight)\n193\t                    val p3 = coordinates.windowToLocal(patchRectInWindow.bottomLeft)\n194\t                    val p4 = coordinates.windowToLocal(patchRectInWindow.bottomRight)\n195\t\n196\t                    // 计算本地坐标系下的真实外接矩形范围\n197\t                    val minX = minOf(p1.x, p2.x, p3.x, p4.x)\n198\t                    val maxX = maxOf(p1.x, p2.x, p3.x, p4.x)\n199\t                    val minY = minOf(p1.y, p2.y, p3.y, p4.y)\n200\t                    val maxY = maxOf(p1.y, p2.y, p3.y, p4.y)\n201\t\n202\t                    val temp = Rect(minX, minY, maxX, maxY)\n203\t                    if (temp != patchAreaCache) {\n204\t                        patchAreaCache = temp\n205\t                    }\n206\t                } else {\n207\t                    patchAreaCache = Rect.Zero\n208\t                }\n209\t\n210\t                /* 废案：无法相应旋转\n211\t                val pageRect = coordinates.boundsInWindow(clipBounds = false)\n212\t                val patchRect = coordinates.boundsInWindow(clipBounds = true)\n213\t                if (!patchRect.isEmpty) {\n214\t                    // patchArea.offset(-viewArea.left, -viewArea.top);\n215\t                    // 这一步将以屏幕左上角的 patchRect 转变为以整页为左上角坐标的 patchArea\n216\t                    val temp = patchRect.translate(-pageRect.left, -pageRect.top)\n217\t                    // 计算是否更新\n218\t                    if (temp != patchAreaCache) patchAreaCache = temp\n219\t                } else {\n220\t                    patchAreaCache = Rect.Zero\n221\t                }\n222\t                */\n223\t            },\n224\t        contentAlignment = Alignment.Center\n225\t    ) {\n226\t        val viewMaxWidth = constraints.maxWidth\n227\t        val viewMaxHeight = constraints.maxHeight\n228\t\n229\t        val ptToPxScale = viewMaxWidth.toFloat() / pdfSize.x\n230\t        val pxToPtScale = 1f / ptToPxScale\n231\t\n232\t        // setPage(int page, PointF size)\n233\t        LaunchedEffect(mPageNumber) {\n234\t            pageState = pageState.copy(mIsLoading = true, mError = null)\n235\t            withContext(Dispatchers.IO) {\n236\t                val cookie = Cookie()\n237\t                try {\n238\t                    // getLinkInfo()\n239\t                    val links = try {\n240\t                        mCore.getPageLinks(mPageNumber) ?: emptyArray()\n241\t                    } catch (e: Exception) {\n242\t                        emptyArray()\n243\t                    }\n244\t\n245\t                    // 计算动态倍率\n246\t                    val parentWidthPx = viewMaxWidth.toFloat()\n247\t                    // mSourceScale\n248\t                    // 由于定死了容器宽高比，这里 parentWidthPx / pdfSize.x = parentHeightPx / pdfSize.y\n249\t                    val mSourceScale = parentWidthPx / pdfSize.x\n250\t\n251\t                    val pageW = (pdfSize.x * mSourceScale).toInt()\n252\t                    val pageH = (pdfSize.y * mSourceScale).toInt()\n253\t                    val bitmap = createBitmap(pageW, pageH)\n254\t\n255\t                    // mDrawEntire, getDrawPageTask()\n256\t                    mCore.drawPage(\n257\t                        bitmap, mPageNumber,\n258\t                        pageW, pageH,\n259\t                        0, 0,\n260\t                        pageW, pageH,\n261\t                        cookie\n262\t                    )\n263\t                    if (!isActive) {\n264\t                        bitmap.recycle(); return@withContext\n265\t                    }\n266\t\n267\t                    withContext(Dispatchers.Main) {\n268\t                        pageState = pageState.copy(\n269\t                            mEntireBm = bitmap,\n270\t                            mLinks = links,\n271\t                            mIsLoading = false,\n272\t                            mSearchBoxes = mSearchBoxes // setSearchBoxes()\n273\t                        )\n274\t                    }\n275\t                } catch (e: Exception) {\n276\t                    withContext(Dispatchers.Main) {\n277\t                        // setRenderError(String why)\n278\t                        pageState = pageState.copy(\n279\t                            mIsLoading = false,\n280\t                            mError = e.message ?: \"Error loading page\"\n281\t                        )\n282\t                    }\n283\t                } finally {\n284\t                    cookie.destroy()\n285\t                }\n286\t            }\n287\t        }\n288\t\n289\t        // updateHq()\n290\t        // 依据 patchAreaCache 的值请求渲染瓦片层\n291\t        LaunchedEffect(mPageNumber) {\n292\t            snapshotFlow {\n293\t                val scale = transform.scaleAnim.value\n294\t                val patchArea = patchAreaCache\n295\t                // 如果未放大、或视口未传入、或底图还在加载，则返回 null，后续清空 Patch 并跳过\n296\t                if (scale <= 1f || patchArea.isEmpty || pageState.mEntireBm == null) null\n297\t                else scale to patchArea\n298\t            }\n299\t                .debounce(200.milliseconds)\n300\t                .collect { snapshot ->\n301\t                    if (snapshot != null) {\n302\t                        // updateHq()\n303\t                        withContext(Dispatchers.IO) {\n304\t                            val (scale, patchArea) = snapshot\n305\t                            val cookie = Cookie()\n306\t                            try {\n307\t                                // to Int\n308\t                                val patchX = (patchArea.left * scale).roundToInt()\n309\t                                val patchY = (patchArea.top * scale).roundToInt()\n310\t                                val patchW = (patchArea.width * scale).roundToInt()\n311\t                                val patchH = (patchArea.height * scale).roundToInt()\n312\t\n313\t                                val pageW = (viewMaxWidth * scale).toInt()\n314\t                                val pageH = (viewMaxHeight * scale).toInt()\n315\t                                if (patchW <= 0 || patchH <= 0) return@withContext\n316\t\n317\t                                val patchBitmap = createBitmap(patchW, patchH)\n318\t\n319\t                                mCore.drawPage(\n320\t                                    patchBitmap, mPageNumber,\n321\t                                    pageW, pageH,\n322\t                                    patchX, patchY, patchW, patchH,\n323\t                                    cookie\n324\t                                )\n325\t\n326\t                                // TODO: 测试用，在渲染完成后，盖上一层半透明红\n327\t                                val canvas = android.graphics.Canvas(patchBitmap)\n328\t                                canvas.drawColor(0x88FF0000.toInt())\n329\t\n330\t                                if (!isActive) {\n331\t                                    patchBitmap.recycle(); return@withContext\n332\t                                }\n333\t\n334\t                                withContext(Dispatchers.Main) {\n335\t                                    val oldBm = patchState.mPatchBm\n336\t                                    patchState = patchState.copy(\n337\t                                        mPatchBm = patchBitmap,\n338\t                                        patchViewSize = IntSize(pageW, pageH),\n339\t                                        patchArea = patchArea,\n340\t                                        scale = scale\n341\t                                    )\n342\t                                    oldBm?.recycle()\n343\t                                }\n344\t                            } catch (e: Exception) {\n345\t                                e.printStackTrace()\n346\t                            } finally {\n347\t                                cookie.destroy()\n348\t                            }\n349\t                        }\n350\t                    } else {\n351\t                        val oldBm = patchState.mPatchBm\n352\t                        patchState = PatchState() // removeHq()\n353\t                        oldBm?.recycle()\n354\t                    }\n355\t                }\n356\t        }\n357\t\n358\t        // 同步搜索高亮\n359\t        LaunchedEffect(mSearchBoxes) {\n360\t            pageState = pageState.copy(mSearchBoxes = mSearchBoxes)\n361\t        }\n362\t\n363\t        // reinit(), releaseResources(), releaseBitmaps()\n364\t        DisposableEffect(mPageNumber) {\n365\t            onDispose {\n366\t                pageState.mEntireBm?.recycle()\n367\t                patchState.mPatchBm?.recycle()\n368\t                pageState = PageState()\n369\t                patchState = PatchState()\n370\t            }\n371\t        }\n372\t\n373\t        // UI\n374\t        if (pageState.mIsLoading) {\n375\t            // mBusyIndicator, blank(int page)\n376\t            CircularProgressIndicator()\n377\t        }\n378\t        // clearRenderError()\n379\t        else if (pageState.mError != null) {\n380\t            // mErrorIndicator\n381\t            Icon(\n382\t                painter = painterResource(id = R.drawable.ic_error_red_24dp),\n383\t                contentDescription = \"Render Error\",\n384\t                tint = Color.Unspecified\n385\t            )\n386\t        } else {\n387\t            pageState.mEntireBm?.let { entireBitmap ->\n388\t                Box(\n389\t                    modifier = Modifier\n390\t                        // onMeasure()\n391\t                        .fillMaxSize()\n392\t                        .pointerInput(entireBitmap, pageState.mLinks) {\n393\t                            awaitEachGesture {\n394\t                                // hitLink(float x, float y)\n395\t                                val down = awaitFirstDown(requireUnconsumed = false)\n396\t                                val docRelX = down.position.x * pxToPtScale\n397\t                                val docRelY = down.position.y * pxToPtScale\n398\t                                val hitLink = pageState.mLinks.firstOrNull {\n399\t                                    it.bounds.contains(docRelX, docRelY)\n400\t                                }\n401\t                                if (hitLink != null) {\n402\t                                    down.consume() // 点中链接，消费事件\n403\t                                    val up = waitForUpOrCancellation()\n404\t                                    if (up != null) {\n405\t                                        up.consume()\n406\t                                        if (hitLink.isExternal) {\n407\t                                            val intent = Intent(\n408\t                                                Intent.ACTION_VIEW,\n409\t                                                Uri.parse(hitLink.uri)\n410\t                                            ).apply {\n411\t                                                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)\n412\t                                            }\n413\t                                            try {\n414\t                                                mContext.startActivity(\n415\t                                                    Intent.createChooser(\n416\t                                                        intent,\n417\t                                                        null\n418\t                                                    )\n419\t                                                )\n420\t                                            } catch (e: Exception) {\n421\t                                                e.printStackTrace()\n422\t                                            }\n423\t                                        } else {\n424\t                                            viewModel.goToPage(mCore.resolveLink(hitLink))\n425\t                                        }\n426\t                                    }\n427\t                                } else { // 没点中链接\n428\t                                    val up = waitForUpOrCancellation() // 等待抬起\n429\t                                    if (up != null) {\n430\t                                        // 检查是否有选择文字\n431\t                                        if (pageState.mSelectionQuads != null) {\n432\t                                            up.consume() // 有选文，清除选文并消费事件\n433\t                                            pageState = pageState.copy(\n434\t                                                mSelectionQuads = null,\n435\t                                                mSelectedText = null,\n436\t                                                mSelectedArea = null\n437\t                                            )\n438\t                                        }\n439\t                                    }\n440\t                                    // 最终若不消费，则事件透传给外层\n441\t                                }\n442\t                            }\n443\t                        }\n444\t                        .pointerInput(entireBitmap) {\n445\t                            // Detect Text Selection\n446\t                            detectDragGesturesAfterLongPress(\n447\t                                onDragStart = { offset ->\n448\t                                    val p = Point(\n449\t                                        offset.x * pxToPtScale,\n450\t                                        offset.y * pxToPtScale\n451\t                                    )\n452\t                                    updateSelection(p, p)\n453\t                                },\n454\t                                onDrag = { change, _ ->\n455\t                                    change.consume()\n456\t                                    val p2 = Point(\n457\t                                        change.position.x * pxToPtScale,\n458\t                                        change.position.y * pxToPtScale\n459\t                                    )\n460\t                                    updateSelection(pageState.mSelectedArea?.start, p2)\n461\t                                }\n462\t                            )\n463\t                        }\n464\t                ) {\n465\t                    // Layer 1: mEntire\n466\t                    Image(\n467\t                        bitmap = entireBitmap.asImageBitmap(),\n468\t                        contentDescription = \"PDF Page $mPageNumber Base\",\n469\t                        modifier = Modifier.fillMaxSize(),\n470\t                        contentScale = ContentScale.FillBounds\n471\t                    )\n472\t\n473\t                    // Layer 2: mPatch\n474\t                    patchState.mPatchBm?.let { patchBitmap ->\n475\t                        if (!patchBitmap.isRecycled) {\n476\t                            val density = LocalDensity.current\n477\t                            val patchArea = patchState.patchArea\n478\t                            //val scale = transform.scaleAnim.value\n479\t                            val scale = patchState.scale\n480\t\n481\t                            Image(\n482\t                                bitmap = patchBitmap.asImageBitmap(),\n483\t                                contentDescription = \"PDF Page $mPageNumber HQ Patch\",\n484\t                                modifier = Modifier\n485\t                                    // onLayout()\n486\t                                    .offset {\n487\t                                        Log.d(APP, \"$patchArea\")\n488\t                                        IntOffset(\n489\t                                            x = patchArea.left.roundToInt(),\n490\t                                            y = patchArea.top.roundToInt()\n491\t                                        )\n492\t                                    }\n493\t                                    .size(\n494\t                                        width = with(density) { patchArea.width.toDp() },\n495\t                                        height = with(density) { patchArea.height.toDp() }\n496\t                                    )\n497\t                                    .graphicsLayer {\n498\t                                        // 让瓦片层拥有独立的 GPU Layer 以提升性能\n499\t                                        shadowElevation = 0f\n500\t                                    },\n501\t                            )\n502\t                        }\n503\t                    }\n504\t\n505\t                    // Layer 3: mSearchView\n506\t                    Canvas(modifier = Modifier.matchParentSize()) {\n507\t                        // Search Highlight\n508\t                        pageState.mSearchBoxes?.forEach { searchBox ->\n509\t                            searchBox.forEach { q ->\n510\t                                val path = Path().apply {\n511\t                                    moveTo(q.ul_x * ptToPxScale, q.ul_y * ptToPxScale)\n512\t                                    lineTo(q.ur_x * ptToPxScale, q.ur_y * ptToPxScale)\n513\t                                    lineTo(q.lr_x * ptToPxScale, q.lr_y * ptToPxScale)\n514\t                                    lineTo(q.ll_x * ptToPxScale, q.ll_y * ptToPxScale)\n515\t                                    close()\n516\t                                }\n517\t                                drawPath(path = path, color = HIGHLIGHT_COLOR)\n518\t                            }\n519\t                        }\n520\t\n521\t                        // Link Highlight\n522\t                        if (mHighlightLinks && pageState.mLinks.isNotEmpty()) {\n523\t                            pageState.mLinks.forEach { link ->\n524\t                                val bounds = link.bounds\n525\t                                drawRect(\n526\t                                    color = LINK_COLOR,\n527\t                                    topLeft = Offset(\n528\t                                        bounds.x0 * ptToPxScale,\n529\t                      